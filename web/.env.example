# Copie para web/.env.local (não commitar).
# Mesmo projeto Supabase do app Expo (frontend/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API Express (backend/). Usada só no servidor (nunca vai para o browser).
# Dev local: http://localhost:3333 — produção: URL do Easypanel.
MEI_API_URL=http://localhost:3333

# Enquanto as outras telas não são migradas, os itens do menu que ainda não existem
# aqui abrem no app atual (Expo web). Deixe vazio para mostrá-los desabilitados.
NEXT_PUBLIC_LEGACY_APP_URL=http://localhost:8081
