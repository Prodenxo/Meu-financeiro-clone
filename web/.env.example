# Copie para web/.env.local (não commitar).
# Mesmo projeto Supabase do app Expo (frontend/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API Express (pasta backend/ deste repo). Só no servidor.
# Dev: npm run dev:api ou npm run dev (sobe API + web)
MEI_API_URL=http://localhost:3333

# Easypanel — serviço frontsiteappmeufinanceiro (/web):
# Ambiente (runtime): MEI_API_URL, NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# Build args (no deploy Docker, mesmos NEXT_PUBLIC_*): obrigatório para o bundle do browser
# Não use VITE_* / EXPO_PUBLIC_* neste serviço.
# MEI_API_URL=https://auto-back-meufinanceiro-site.4tnf3f.easypanel.host

# Open Finance — polling só com aba aberta (localhost sem webhook). Opcional:
# NEXT_PUBLIC_OF_POLL_BALANCE_SEC=300
# NEXT_PUBLIC_OF_POLL_FULL_SEC=900

# Expo web legado (:8081). Menu do site já está todo no Next; pode deixar vazio.
NEXT_PUBLIC_LEGACY_APP_URL=
