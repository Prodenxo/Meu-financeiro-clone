# Copie para .env e preencha com valores reais. Nunca commite .env.
#
# Backend da API (obrigatório em build/deploy): URL absoluta com esquema.
# Local: http://localhost:3333 (ou deixe o proxy do Vite em dev conforme README do projeto).
# Produção/preview (Vercel ou outro): https://<seu-backend>.vercel.app — o frontend só fala com o backend; Plugnotas é chamado só no servidor.
VITE_API_URL=http://localhost:3333
# Indicador discreto na Guia MEI (DEV): GET /health. Em dev fica ligado por padrão; desligue com false.
# Em produção o selo não aparece salvo VITE_SHOW_API_HEALTH_INDICATOR=true (evite em app público).
# Se usar a flag em produção com frontend e backend em origens diferentes, o backend precisa permitir CORS em GET /health
# para a origem do frontend (o proxy do Vite só vale em dev).
# VITE_SHOW_API_HEALTH_INDICATOR=false
# Opcional (Guia MEI): URL da doc completa com âncora NFC-e (GitHub ao markdown etc.). Se vazio, o app usa o guia
# estático em /guia-mei-nfce-cadastro.html (public) com link sempre clicável + nota sobre docs/operacao-mei-nfse.md.
# VITE_MEI_OPERACAO_NFSE_DOC_URL=https://github.com/ORG/REPO/blob/main/docs/operacao-mei-nfse.md#cadastro-empresa-nfce-qrcode-sefaz
# (O app também substitui a âncora para conectividade local — #guia-mei-conectividade-local — no alerta de certificado quando aplicável.)
VITE_MEI_OPERACAO_NFSE_DOC_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
